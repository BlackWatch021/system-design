                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ref-arch-34" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Group message (100 members)&lt;/b&gt;&lt;br&gt;G1. read chat_members (cached)&lt;br&gt;G2. registry MGET for all 100 → which server each is on&lt;br&gt;G3. group by server → PUBLISH &lt;b&gt;once per server&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(100 members on 40 servers = 40 publishes)&lt;br&gt;G4. 30 offline → push jobs; they sync on reconnect&lt;br&gt;The message is stored &lt;b&gt;once&lt;/b&gt; (no per-member copies).&lt;br&gt;Very large groups → hand fan-out to a queue + workers." vertex="1">
                    <mxGeometry height="170" width="400" y="610" as="geometry"/>
                </mxCell>
                <mxCell id="ref-arch-35" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" value="REST + media (not real-time)" vertex="1">

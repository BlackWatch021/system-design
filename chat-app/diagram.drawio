                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ref-arch-51" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Fixes compared with my diagram&lt;/b&gt;&lt;br&gt;• WebSocket runs over &lt;b&gt;TCP&lt;/b&gt;, not UDP. The phone connects through the LB &lt;b&gt;straight to a chat server&lt;/b&gt;; the upgrade happens on that connection (no hand-off from HTTP servers).&lt;br&gt;• &lt;b&gt;Every&lt;/b&gt; message is saved (step 2) before it is published, not only when the user is offline.&lt;br&gt;• Two chat servers are drawn so the relay (server 4 → pub/sub → server 8) is visible, including the way back for ✓✓.&lt;br&gt;• Offline path goes to the notification queue / push (Exercise 3).&lt;br&gt;• Messages DB is &lt;b&gt;sharded by chat_id&lt;/b&gt;: replicas alone can&#39;t hold ~2 PB.&lt;br&gt;• Media is downloaded through the CDN." vertex="1">
                    <mxGeometry height="150" width="920" y="1070" as="geometry"/>
                </mxCell>
            </root>
